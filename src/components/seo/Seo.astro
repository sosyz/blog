---
/**
 * Everything in <head> that describes the page: title, description,
 * canonical, robots, Open Graph, Twitter card, RSS / Markdown / sitemap
 * discovery and JSON-LD.
 *
 * - On "/" it adds WebSite + Person JSON-LD.
 * - When `canonical` is a note (/notes/<slug>/) it looks the post up and adds
 *   BlogPosting + BreadcrumbList JSON-LD and a link to the Markdown version,
 *   so note pages only need to pass the usual props.
 * - `image` (a post's heroImage) is cropped to 1200×630 JPEG at build time
 *   (a smaller one keeps its own size);
 *   without it the default share image public/og-default.png is used. Do not
 *   pass `image` from on-demand routes (the image service is build-time only).
 *
 * Owner: SEO agent. Base.astro passes these props through.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import {
  AUTHOR,
  absoluteUrl,
  DEFAULT_OG_IMAGE,
  noteMarkdownUrl,
  OG_LOCALE,
  PERSON_ID,
  personNode,
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_NAME,
  serializeJsonLd,
  WEBSITE_ID,
  websiteNode,
} from "@/lib/seo/site";

export type Props = {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path of the canonical URL, e.g. "/notes/go-context/". Defaults to the current path. */
  canonical?: string;
  type?: "website" | "article";
  image?: ImageMetadata;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** One or more JSON-LD objects, serialised into <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep the page out of search results (404, admin). */
  noindex?: boolean;
};

const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const NOTE_PATH = /^\/notes\/(?<slug>[^/]+)\/$/;

const {
  title,
  description = SITE_DESCRIPTION,
  canonical = Astro.url.pathname,
  type = "website",
  image,
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = absoluteUrl(canonical);
const isHome = canonical === "/";

// Covers at least 1200×630 are cropped to exactly that. A smaller image is
// never enlarged or cropped: it is shared at its own size, and the meta tags
// say so.
const fillsCard = image
  ? image.width >= OG_WIDTH && image.height >= OG_HEIGHT
  : false;
const shareSize = image
  ? {
      width: fillsCard ? OG_WIDTH : image.width,
      height: fillsCard ? OG_HEIGHT : image.height,
    }
  : undefined;
const shareImage =
  image && shareSize
    ? await getImage({
        src: image,
        ...shareSize,
        ...(fillsCard ? { fit: "cover" as const } : {}),
        format: "jpg",
        quality: 82,
      })
    : undefined;
const og =
  shareImage && shareSize
    ? {
        url: absoluteUrl(shareImage.src),
        width: shareSize.width,
        height: shareSize.height,
        type: "image/jpeg",
        alt: title ? `《${title}》的封面图` : DEFAULT_OG_IMAGE.alt,
      }
    : {
        url: absoluteUrl(DEFAULT_OG_IMAGE.src),
        width: DEFAULT_OG_IMAGE.width,
        height: DEFAULT_OG_IMAGE.height,
        type: "image/png",
        alt: DEFAULT_OG_IMAGE.alt,
      };

const noteSlug = NOTE_PATH.exec(canonical)?.groups?.slug;
// Imported lazily so on-demand pages (e.g. /admin/) that render through
// Base.astro do not load the content collection.
const posts = noteSlug ? await import("@/lib/posts") : undefined;
const post = noteSlug ? await posts?.getPost(noteSlug) : undefined;

const graph: Record<string, unknown>[] = [];
if (isHome || post) {
  graph.push(websiteNode(), personNode());
}
if (post && posts) {
  const { data } = post;
  graph.push(
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      headline: data.title,
      description: data.description,
      url: canonicalUrl,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      datePublished: data.pubDate.toISOString(),
      dateModified: posts.lastUpdated(post).toISOString(),
      author: {
        "@type": "Person",
        "@id": PERSON_ID,
        name: AUTHOR.name,
        url: AUTHOR.url,
      },
      publisher: { "@id": PERSON_ID },
      isPartOf: { "@id": WEBSITE_ID },
      image: {
        "@type": "ImageObject",
        url: og.url,
        width: og.width,
        height: og.height,
      },
      keywords: data.tags.join(", "),
      articleSection: data.topic,
      inLanguage: SITE_LANGUAGE,
      encodingFormat: "text/html",
      ...(data.source ? { isBasedOn: data.source } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: SITE_NAME,
          item: absoluteUrl("/"),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "全部笔记",
          item: absoluteUrl("/list/"),
        },
        {
          "@type": "ListItem",
          position: 3,
          name: data.title,
          item: canonicalUrl,
        },
      ],
    },
  );
}
if (jsonLd) {
  graph.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
}
const structuredData =
  graph.length > 0
    ? serializeJsonLd({ "@context": "https://schema.org", "@graph": graph })
    : undefined;

const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large";
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />
<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonicalUrl} />}
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_NAME}
  href={absoluteUrl("/rss.xml")}
/>
{noteSlug && (
  <link
    rel="alternate"
    type="text/markdown"
    title="Markdown 原文"
    href={noteMarkdownUrl(noteSlug)}
  />
)}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={OG_LOCALE} />
<meta property="og:type" content={type} />
{!noindex && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:title" content={title ?? SITE_NAME} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og.url} />
<meta property="og:image:type" content={og.type} />
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={og.alt} />
{type === "article" && publishedTime && (
  <meta
    property="article:published_time"
    content={publishedTime.toISOString()}
  />
)}
{type === "article" && (modifiedTime ?? publishedTime) && (
  <meta
    property="article:modified_time"
    content={(modifiedTime ?? publishedTime)?.toISOString()}
  />
)}
{type === "article" && <meta property="article:author" content={AUTHOR.url} />}
{type === "article" &&
  tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE_NAME} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og.url} />
<meta name="twitter:image:alt" content={og.alt} />

{structuredData && (
  <script is:inline type="application/ld+json" set:html={structuredData} />
)}
