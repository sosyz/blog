---
/**
 * Home: the canvas. On narrow screens (<640px) the same page shows the list
 * first (CSS switch, so `/` stays fully crawlable); the toolbar's 画布 / 列表
 * flips between them and remembers the choice for the tab.
 */
import Canvas from "@/components/canvas/Canvas.astro";
import NoteList from "@/components/canvas/NoteList.astro";
import Toolbar from "@/components/canvas/Toolbar.astro";
import StickerUpload from "@/components/interact/StickerUpload.astro";
import Base from "@/layouts/Base.astro";
---

<Base canonical="/" bodyClass="view-canvas">
  <Toolbar view="canvas" home>
    <StickerUpload />
  </Toolbar>
  <main class="home" id="main" data-home data-view="auto">
    <Canvas />
    <div class="home-list list desk-paper">
      <NoteList titleTag="h2" />
    </div>
  </main>
</Base>
