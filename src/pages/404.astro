---
/**
 * 404: a sticky note left on the desk.
 *
 * Owner: SEO agent.
 */
import SiteFooter from "@/components/site/SiteFooter.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="页面不见了"
  description="这个地址没有内容，可能是链接写错了，或者笔记换了地方。"
  noindex
  bodyClass="view-404"
>
  <main class="lost desk-paper">
    <div class="note sticky-paper">
      <p class="code" aria-hidden="true">
        404
      </p>
      <h1>这一页被风吹走了</h1>
      <p>这个地址上什么也没有。可能是链接写错了，也可能是笔记换了地方。</p>
      <ul class="ways">
        <li>
          <a href="/">回到画布</a>
        </li>
        <li>
          <a href="/list/">看全部笔记</a>
        </li>
        <li>
          <a href="/links/">友链</a>
        </li>
      </ul>
      <SiteFooter class="fine" />
    </div>
    <img
      class="sticker cloud"
      src="/stickers/obj-cloud.webp"
      alt=""
      width="120"
      height="120"
    />
    <span
      class="doodle swoosh"
      style="--doodle: url('/journal/doodle/arrow-loop.svg')"
      aria-hidden="true"
    ></span>
  </main>
</Base>

<style>
  .lost {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: 48px 16px;
    overflow: hidden;
  }

  .note {
    position: relative;
    width: min(340px, 100%);
    padding: 26px 24px 28px;
    font-family: var(--hand);
    color: var(--ink);
    rotate: -2.4deg;
  }

  .code {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.2em;
    color: var(--stamp);
    opacity: 0.8;
  }

  h1 {
    margin: 4px 0 10px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.3;
  }

  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 19px;
  }

  .note :global(.fine) {
    margin: 16px 0 0;
  }

  .ways a {
    text-decoration-style: wavy;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .cloud {
    --w: 120px;
    --r: 8deg;
    position: absolute;
    top: calc(50% - 230px);
    left: calc(50% + 110px);
    pointer-events: none;
  }

  .swoosh {
    position: absolute;
    top: calc(50% - 170px);
    left: calc(50% + 60px);
    width: 70px;
    height: 56px;
    rotate: 160deg;
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .cloud {
      --w: 84px;
      top: 24px;
      left: auto;
      right: 16px;
    }

    .swoosh {
      display: none;
    }
  }
</style>
