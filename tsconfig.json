{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "astro.config.mjs"
  ],
  "exclude": ["dist", "fonts-src", "public"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "bun"]
  }
}
