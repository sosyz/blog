# Build-time variables. Copy to .env (gitignored) or set them in CI.

# Optional. The Turnstile site key is normally served at runtime by /api/turnstile
# (wrangler.jsonc `vars` / .dev.vars). Set it here only to bake a key into the pages;
# never leave the test key here for a production build.
TURNSTILE_SITE_KEY=

# Optional: AI alt text for images at build time (src/lib/ai/image.ts).
# Without it the build still works and uses a generic alt text.
OPENROUTER_API_KEY=
