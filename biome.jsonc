{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "javascript": {
    "globals": ["Bun"]
  },
  "files": {
    "includes": [
      "**",
      "!src/**/*.astro",
      "!public/fonts",
      "!public/ort",
      "!public/models",
      "!worker-configuration.d.ts",
      "!fonts-src",
      "!wrangler.jsonc"
    ]
  },
  "linter": {
    "includes": [
      "**",
      "!src/**/*.astro",
      "!public/fonts",
      "!public/ort",
      "!public/models",
      "!worker-configuration.d.ts",
      "!fonts-src",
      "!wrangler.jsonc"
    ]
  },
  "extends": ["ultracite"]
}
